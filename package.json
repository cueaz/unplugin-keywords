{
  "name": "unplugin-keywords",
  "version": "2.3.0",
  "packageManager": "pnpm@11.0.7+sha512.724a7b5d2319cdd7009d65e15a2c29aae9d3902b50585ca163d38a7737eb85bc4e72196879ff59768a71e81fe32aa71e8b70f088b2e24b9e4a2850d87e4607b5",
  "description": "A build plugin for structural string literal minification and obfuscation.",
  "keywords": [
    "unplugin",
    "rollup",
    "rollup-plugin",
    "vite",
    "vite-plugin",
    "minification",
    "obfuscation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cueaz/unplugin-keywords.git"
  },
  "license": "MIT",
  "author": "cueaz",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "default": "./dist/esbuild.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "default": "./dist/rollup.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "default": "./dist/webpack.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./transform": {
      "types": "./dist/transform.d.ts",
      "default": "./dist/transform.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "keywords": "./bin/cli.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "precheck": "pnpm --filter \"./demo/*\" typegen",
    "check": "tsc --build && biome check",
    "format": "biome check --write",
    "build": "tsdown",
    "build:demo": "pnpm --filter \"./demo/*\" build",
    "test": "vitest run",
    "test:demo": "pnpm --filter \"./demo/*\" test"
  },
  "dependencies": {
    "@babel/core": "catalog:",
    "globby": "catalog:",
    "p-limit": "catalog:",
    "unplugin": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@tsconfig/bases": "catalog:",
    "@types/babel__core": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
