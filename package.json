{
  "name": "unplugin-keywords",
  "version": "2.0.0",
  "description": "A build plugin for structural string literal minification and obfuscation.",
  "keywords": [
    "unplugin",
    "rollup",
    "rollup-plugin",
    "vite",
    "vite-plugin",
    "minification",
    "obfuscation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cueaz/unplugin-keywords.git"
  },
  "license": "MIT",
  "author": "cueaz",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "default": "./dist/esbuild.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "default": "./dist/rollup.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "default": "./dist/webpack.js"
    },
    "./transform": {
      "types": "./dist/transform.d.ts",
      "default": "./dist/transform.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "keywords": "dist/bin/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "tsc --build && biome check",
    "format": "biome check --write",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/core": "catalog:",
    "globby": "catalog:",
    "p-limit": "catalog:",
    "unplugin": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@tsconfig/bases": "catalog:",
    "@types/babel__core": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
