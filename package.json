{
  "name": "unplugin-keywords",
  "version": "2.1.0",
  "packageManager": "pnpm@11.0.5+sha512.94fa09e72016402aefce788e46994e18eb1922998b16b6fd5aa6bafd8ae4dea05d0852f60247fdb7d5ab8199a7b0beda830398f3f80cb9f822398522a1535481",
  "description": "A build plugin for structural string literal minification and obfuscation.",
  "keywords": [
    "unplugin",
    "rollup",
    "rollup-plugin",
    "vite",
    "vite-plugin",
    "minification",
    "obfuscation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cueaz/unplugin-keywords.git"
  },
  "license": "MIT",
  "author": "cueaz",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "default": "./dist/esbuild.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "default": "./dist/rollup.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "default": "./dist/webpack.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./transform": {
      "types": "./dist/transform.d.ts",
      "default": "./dist/transform.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "keywords": "./bin/cli.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "precheck": "pnpm --filter \"./demo/*\" typegen",
    "check": "tsc --build && biome check",
    "format": "biome check --write",
    "build": "tsdown",
    "build:demo": "pnpm --filter \"./demo/*\" build",
    "test": "vitest run",
    "test:demo": "pnpm --filter \"./demo/*\" test"
  },
  "dependencies": {
    "@babel/core": "catalog:",
    "globby": "catalog:",
    "p-limit": "catalog:",
    "unplugin": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@tsconfig/bases": "catalog:",
    "@types/babel__core": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
