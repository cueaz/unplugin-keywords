{
  "name": "unplugin-keywords",
  "version": "2.0.0",
  "description": "A Rollup/Vite plugin that provides minifiable keywords to use in place of string literals for aggressive minification/obfuscation.",
  "keywords": [
    "unplugin",
    "rollup",
    "rollup-plugin",
    "vite",
    "vite-plugin",
    "minification",
    "obfuscation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cueaz/unplugin-keywords.git"
  },
  "license": "MIT",
  "author": "cueaz",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "default": "./dist/esbuild.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "default": "./dist/rollup.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "default": "./dist/webpack.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "keywords": "dist/bin/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "tsc --build && biome check",
    "clean": "rimraf dist",
    "format": "biome check --write",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/core": "^7.29.0",
    "globby": "^16.2.0",
    "unplugin": "^3.0.0",
    "xxhash-wasm": "^1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@tsconfig/bases": "^1.0.23",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^25.6.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
