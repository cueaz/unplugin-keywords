{
  "name": "unplugin-keywords",
  "version": "2.9.1",
  "packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f",
  "description": "A build plugin for structural string literal minification and obfuscation.",
  "keywords": [
    "unplugin",
    "rollup",
    "rollup-plugin",
    "vite",
    "vite-plugin",
    "minification",
    "obfuscation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cueaz/unplugin-keywords.git"
  },
  "license": "MIT",
  "author": "cueaz",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "default": "./dist/bun.js"
    },
    "./esbuild": {
      "types": "./dist/esbuild.d.ts",
      "default": "./dist/esbuild.js"
    },
    "./farm": {
      "types": "./dist/farm.d.ts",
      "default": "./dist/farm.js"
    },
    "./rolldown": {
      "types": "./dist/rolldown.d.ts",
      "default": "./dist/rolldown.js"
    },
    "./rollup": {
      "types": "./dist/rollup.d.ts",
      "default": "./dist/rollup.js"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "default": "./dist/rspack.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./webpack": {
      "types": "./dist/webpack.d.ts",
      "default": "./dist/webpack.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "keywords": "./bin/cli.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "precheck": "pnpm --filter \"./demo/*\" typegen",
    "check": "tsc --build && biome check",
    "format": "biome check --write",
    "build": "tsdown",
    "build:demo": "pnpm --filter \"./demo/*\" build",
    "test": "vitest run",
    "test:demo": "pnpm --filter \"./demo/*\" test"
  },
  "dependencies": {
    "@babel/core": "catalog:",
    "globby": "catalog:",
    "p-limit": "catalog:",
    "unplugin": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@tsconfig/bases": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
